#!/usr/bin/env bash
#
# pre-push hook: refuse to push anything that looks like a secret.
#
# Install with:  git config core.hooksPath scripts
#
# git feeds this hook one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
# A remote sha of all-zeros means the branch is new on the remote, so there is
# no "since" point -- scan the whole branch rather than a range.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
SCAN="$ROOT/scripts/scan-secrets.sh"
ZERO="0000000000000000000000000000000000000000"
STATUS=0

while read -r _LOCAL_REF LOCAL_SHA _REMOTE_REF REMOTE_SHA; do
  [ "$LOCAL_SHA" = "$ZERO" ] && continue          # branch deletion

  if [ "$REMOTE_SHA" = "$ZERO" ]; then
    RANGE="$LOCAL_SHA"                            # new branch: whole history
  else
    RANGE="$REMOTE_SHA..$LOCAL_SHA"
  fi

  bash "$SCAN" "$RANGE" || STATUS=1
done

if [ "$STATUS" != "0" ]; then
  echo "pre-push: push refused." >&2
fi

exit "$STATUS"
